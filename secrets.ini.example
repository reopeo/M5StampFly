; Copy this file to secrets.ini and replace the placeholder values locally.
; secrets.ini is intentionally ignored and must never be committed.
[env]
build_flags =
    -DCORE_DEBUG_LEVEL=0
    -O0
    -DDRONE_WIFI_SSID=\"replace-with-private-ssid\"
    -DDRONE_WIFI_PASSWORD=\"replace-with-private-password\"
    -DDRONE_PC_IP=\"192.168.1.10\"
    -DDRONE_UDP_PORT=5600
    -DDRONE_UDP_SOURCE_PORT=5602
